# 1. Set default behavior for all files (Detect text, enforce LF)
* text=auto eol=lf

# 2. Protect Binary Files (Images, Video, Audio, Fonts)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.mov binary
*.webm binary
*.mp3 binary
*.wav binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# 3. Exceptions
*.svg text